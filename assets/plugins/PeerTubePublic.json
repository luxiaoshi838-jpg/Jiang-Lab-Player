  "type": "video",
  "version": "1.0",
  "muliSources": false,
  "useWebview": false,
  "useNativePlayer": true,
  "userAgent": "",
  "baseURL": "https://peertube.tv/",
  "searchURL": "",
  "searchList": "",
  "searchName": "",
  "searchResult": "",
  "chapterRoads": "",
  "chapterResult": "",
  "searchMode": "api",
  "chapterMode": "api",
  "searchApiConfig": {
    "request": {
      "method": "GET",
